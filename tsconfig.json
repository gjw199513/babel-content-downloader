{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "chrome"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["shared/**/*.ts", "runtime/**/*.ts", "extension/**/*.ts", "adapters/**/*.ts", "bootstrap/**/*.ts", "tests/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
